# 忽略操作系统产生的杂项文件
.DS_Store
Thumbs.db
desktop.ini

# 忽略编辑器 / IDE 配置
.vscode/
.idea/
*.swp

# 我会在 README 里让用户自己生成部署用的 zip，产物不入库
site-deploy.zip

# 本地预览截图
_preview.png

# 本地预览服务器存的管理密码与通知数据（只在本机测试用，不入库）
.preview-notify.json

# 本机抓课表工具的输出：抓到课表的 JSON 备份 + 一个带登录会话的浏览器配置目录
# （里面可能有你的登录 cookie，绝对不能入库）
.timetable-exports/

# Wrangler 本地缓存与 dry-run 产物（校验用，不需要入库）
.wrangler/
.wrangler-dryrun/
node_modules/

# DSH 视觉工具产生的中间文件
.dsh-vision-router/

# Hexo 的依赖与构建产物（如果以后启用 hexo/blog）
hexo/blog/node_modules/
hexo/blog/public/
hexo/blog/db.json
hexo/blog/.deploy_git/

# 地图原图与教务系统导出的课表原件（约 10 MB）。
# 网页用的是 site/assets/map/ 里压缩好的 WebP，部署不需要这里的东西；
# 而且课表文件名里带学号，不适合放进公开仓库。
# 注意开头的斜杠：只忽略仓库根目录的 map/，不要连 site/assets/map/ 一起忽略掉。
# 想把原图也备份进仓库：注释掉下面这行，然后 git add -f map/
/map/

.preview-files/

# ——— DSH 会话产物 ———
# DSH 上传目录：微信图片、导出的课表 HTML、anime 备份 JSON 等，可能含个人信息
.dsh-uploads/

# ——— 抓课表 / 本机脚本的浏览器配置目录（含登录 cookie，绝对不能入库）———
# 旧版工具写过 browser-profile/，历史上只忽略了 .timetable-exports/，两条都留着
browser-profile/
.timetable-exports/browser-profile/

# ——— 站点内容生成器的中间产物与一次性草稿（可重新生成的都不入库）———
# 生成器脚本本身（.gen_*.py / .verify_*.py）请放 tools/acm/ 入库，不要在这里忽略
.*_frag.html
.*_outline.txt
*.orig.md

# ——— 与本仓库无关的本机脚本 / 文档草稿 ———
# 想纳管就单独开分支或另建仓库，别混进站点的特性提交
AMD-TuningLock/
amd-efficiency-doc/

# ——— anime 站点的导入备份（含个人评分数据，不入库）———
anime-import-bg.json

# 本地临时目录：DOM dump、headless 截图、浏览器 profile、临时验证页
tmp/

# 本地临时转换目录（课件/教材转出的中间文件，不入库）
.tmp_ppt/
.slidep/

# Python 生成器跑过之后的缓存
tools/__pycache__/
__pycache__/
*.pyc
